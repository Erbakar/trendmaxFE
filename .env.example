PORT=3001

PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt

# Sunucu siparis numarasi ve tek kullanimlik sorgu anahtarini bu URL'lere ekler.
PAYTR_OK_URL=http://localhost:3000/odeme-sonuc
PAYTR_FAIL_URL=http://localhost:3000/odeme-sonuc

# 1 = test, 0 = canli
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_TIMEOUT_LIMIT=30

# Virgülle ayrılmış izinli web origin'leri. Canlıda gerçek HTTPS alan adını yazın.
PAYTR_ALLOWED_ORIGINS=http://localhost:3000

# Siparişlerin yeniden başlatma sonrasında korunacağı dizin.
PAYTR_ORDER_STORE_PATH=.data/paytr-orders

# Yalnızca uygulama güvenilir tek bir reverse proxy arkasındaysa 1 yapın.
TRUST_PROXY=0

# Frontend ayri bir domainde ise API base tanimlayin
VITE_API_BASE_URL=
